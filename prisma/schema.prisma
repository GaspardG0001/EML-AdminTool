/**
 * ! For enums, add a const in $lib/utils/db.ts with the same name but without the "I" prefix, and the values as keys with the same value.
 * ! This allows using them in both server and client code without importing from @prisma/client directly, which can cause issues in SvelteKit.
 */

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE // User is active and can log in
  PENDING // User is pending activation by an admin, can log in
  SPAM // User is flagged as spam (wrong PIN), can log in
  DELETED // User is deleted and cannot log in
}

enum ProfileVisibility {
  PUBLIC
  HIDDEN
  PROTECTED
}

enum LoaderType {
  VANILLA
  FORGE
  NEOFORGE
  FABRIC
  QUILT
}

enum BackgroundStatus {
  ACTIVE
  INACTIVE
}

enum StatAction {
  STARTUP
  LOGIN
  LAUNCH
  BOOTSTRAP
}

enum SyncRuleAction {
  INCLUDE
  EXCLUDE
}

enum SyncUploadState {
  PENDING
  COMMITTED
  EXPIRED
  ABORTED
}

model Environment {
  id        String   @id @default(cuid(2))
  language  String   @default("en")
  name      String   @default("EML")
  theme     String   @default("default")
  pin       String   @default("000")
  updatedAt DateTime @updatedAt
}

model S3Configuration {
  id                       String   @id @default("1")
  region                   String
  accessKeyIdEncrypted     String
  secretAccessKeyEncrypted String
  bucket                   String
  endpoint                 String
  updatedAt                DateTime @updatedAt
}

model User {
  id                 String                  @id @default(cuid(2))
  username           String                  @unique
  password           String
  status             UserStatus              @default(PENDING)
  isAdmin            Boolean                 @default(false)
  p_filesUpdater     Int                     @default(0) // 0 = no access, 1 = read and write, 2 = read, write and change loader
  p_bootstraps       Int                     @default(0) // 0 = no access, 1 = read and write
  p_maintenance      Int                     @default(0) // 0 = no access, 1 = read and write, 2 = admin (can change allowed pseudos)
  p_news             Int                     @default(0) // 0 = no access, 1 = read and write, 2 = admin (can delete news they did not create)
  p_newsCategories   Int                     @default(0) // 0 = no access, 1 = read and write
  p_newsTags         Int                     @default(0) // 0 = no access, 1 = read and write
  p_backgrounds      Int                     @default(0) // 0 = no access, 1 = read and write
  p_stats            Int                     @default(0) // 0 = no access, 1 = read, 2 = read and reset
  p_crashReports     Int                     @default(0) // 0 = no access, 1 = read, 2 = read and delete
  p_sync             Int                     @default(0) // 0 = no access, 1 = access to the sync page
  profilePermissions UserProfilePermission[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  logs               Log[]
  news               News[]
}

model Log {
  id        String   @id @default(cuid(2))
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?
  timestamp DateTime @default(now())
}

model Loader {
  id               String     @id @default(cuid(2))
  type             LoaderType
  minecraftVersion String
  loaderVersion    String
  customVersion    String?
  file             Json?
  updatedAt        DateTime   @updatedAt
  profileId        String     @unique @default("1")
  profile          Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Profile {
  id              String                  @id @default(cuid(2))
  name            String
  isDefault       Boolean                 @default(false)
  slug            String                  @unique
  ip              String?
  port            Int?
  tcpProtocol     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  loader          Loader?
  hidden          Boolean?                @default(false)
  visibility      ProfileVisibility?      @default(PUBLIC)
  allowedPseudos  String[]                @default([])
  password        String?
  userPermissions UserProfilePermission[]
  syncProfile     SyncProfile?
  syncFiles       SyncFile[]
  syncStates      PlayerSyncState[]
  syncUploads     SyncUpload[]
}

model Bootstrap {
  id        String   @id @default(cuid(2))
  winFile   Json?
  macFile   Json?
  linFile   Json?
  version   String
  updatedAt DateTime @updatedAt
}

model Maintenance {
  id             String    @id @default(cuid(2))
  startTime      DateTime?
  endTime        DateTime?
  message        String    @default("")
  allowedPseudos String[]  @default([])
}

model News {
  id         String         @id @default(cuid(2))
  title      String
  content    String
  authorId   String
  author     User           @relation(fields: [authorId], references: [id])
  categories NewsCategory[]
  tags       NewsTag[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model NewsCategory {
  id        String   @id @default(cuid(2))
  name      String   @unique
  news      News[]
  createdAt DateTime @default(now())
}

model NewsTag {
  id    String @id @default(cuid(2))
  name  String @unique
  color String
  news  News[]
}

model Background {
  id        String           @id @default(cuid(2))
  name      String           @unique
  file      Json
  status    BackgroundStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model Stat {
  id        String     @id @default(cuid(2))
  action    StatAction
  value     String?
  createdAt DateTime   @default(now())
}

model CrashReport {
  id            String    @id @default(cuid(2))
  date          String
  os            String
  arch          String
  javaVersion   String
  javaArch      String
  profile       String?
  version       String
  loader        String
  loaderVersion String?
  authType      String
  minRam        Float?
  maxRam        Float?
  exitCode      Int
  addressedAt   DateTime?
  comment       String?
  createdAt     DateTime  @default(now())
  fileId        String    @unique
}

model ExpiredToken {
  id        String   @id @default(cuid(2))
  token     String   @unique
  expiredAt DateTime @default(now())
}

model SystemMigration {
  id        String   @id
  appliedAt DateTime @default(now())
}

model UserProfilePermission {
  id         String   @id @default(cuid(2))
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  permission Int      @default(0) // 0 = no access, 1 = read and write, 2 = read, write and change loader
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, profileId])
}

model Player {
  id            String  @id @default(cuid(2))
  minecraftUuid String  @unique
  minecraftName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices     PlayerDevice[]
  syncFiles   SyncFile[]
  syncStates  PlayerSyncState[]
  syncUploads SyncUpload[]
}

model PlayerDevice {
  id              String  @id @default(cuid(2))
  playerId        String
  deviceUuid      String
  name            String
  platform        String
  arch            String?
  launcherVersion String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  syncFiles   SyncFile[]
  syncUploads SyncUpload[]

  @@unique([playerId, deviceUuid])
  @@index([playerId])
}

model SyncProfile {
  id              String   @id @default(cuid(2))
  profileId       String   @unique
  enabled         Boolean  @default(false)
  maxStorageBytes BigInt?
  maxFileBytes    BigInt?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  rules   SyncRule[]

  @@index([enabled])
}

model SyncRule {
  id            String         @id @default(cuid(2))
  syncProfileId String
  path          String
  action        SyncRuleAction @default(INCLUDE)
  enabled       Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  syncProfile SyncProfile @relation(fields: [syncProfileId], references: [id], onDelete: Cascade)

  @@index([syncProfileId])
}

model SyncFile {
  id        String   @id @default(cuid(2))
  playerId  String
  profileId String
  path      String
  hash      String?
  size      BigInt   @default(0)
  version   Int      @default(1)
  deleted   Boolean  @default(false)
  objectKey String?
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player  Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  profile Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  device  PlayerDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([playerId, profileId, path])
  @@index([playerId, profileId])
  @@index([hash])
}

model PlayerSyncState {
  id        String   @id @default(cuid(2))
  playerId  String
  profileId String
  revision  BigInt   @default(0)
  updatedAt DateTime @updatedAt

  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([playerId, profileId])
}

model SyncUpload {
  id            String          @id @default(cuid(2))
  playerId      String
  profileId     String
  deviceId      String
  path          String
  hash          String
  size          BigInt
  baseVersion   Int?
  objectKey     String
  reservedBytes BigInt          @default(0)
  state         SyncUploadState @default(PENDING)
  createdAt     DateTime        @default(now())
  expiresAt     DateTime
  committedAt   DateTime?

  player  Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  device  PlayerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([playerId, profileId])
  @@index([expiresAt])
  @@index([playerId, profileId, path, state])
}
